{
  "id": "hunter",
  "token": "HUNTER",
  "name": "Hunter",
  "specs": ["Marksmanship", "Survival (Melee)", "Beast Mastery"],
  "playstyle": "Ranged Kiter / Melee Survival — baseline Aimed Shot (L20), in-combat Traps, Lone Wolf option, pet scaling",
