  "macros": [
    {
      "name": "PW_HNT_FD",
      "icon": "INV_MISC_QUESTIONMARK",
      "description": "Stops casting/attacking, pulls pet passive, and casts Feign Death",
      "body": "#showtooltip Feign Death\n/stopcasting\n/petpassive\n/cast Feign Death"
    },
    {
      "name": "PW_HNT_PET",
      "icon": "INV_MISC_QUESTIONMARK",
      "description": "Sends pet to attack current target, or recalls pet if no enemy target is selected",
      "body": "#showtooltip\n/petattack [harm,nodead]\n/petfollow [noharm][dead]"
    },
    {
      "name": "PW_HNT_TRAP",
      "icon": "INV_MISC_QUESTIONMARK",
      "description": "Deploys Freezing Trap cleanly in combat (WoW Forever combat traps)",
      "body": "#showtooltip Freezing Trap\n/stopcasting\n/cast Freezing Trap"
    },
    {
      "name": "PW_HNT_MARK",
      "icon": "INV_MISC_QUESTIONMARK",
      "description": "Applies Hunter's Mark and sends pet if present",
      "body": "#showtooltip Hunter's Mark\n/cast Hunter's Mark\n/petattack [pet,harm,nodead]"
